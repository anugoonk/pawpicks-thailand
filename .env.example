# PawPicks Thailand — environment template
# Copy to `.env.local` for local development and fill in values.
# NEVER commit .env / .env.local / any file with real keys. Only this template
# is tracked. Local dev must use Supabase Development project + Stripe TEST mode.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3021

# --- Supabase (Development project for local) -----------------------------
# Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
# Project settings > API > service_role. SERVER ONLY. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# --- Stripe (TEST mode keys only for local/dev) --------------------------
# Dashboard > Developers > API keys  (sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen` locally, or Dashboard > Webhooks endpoint signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Store config --------------------------------------------------------
ADMIN_EMAIL=you@example.com
# Flat shipping fee in THB, and the order subtotal (THB) that unlocks free shipping.
SHIPPING_FLAT_RATE=50
FREE_SHIPPING_THRESHOLD=1500
# Optional. When set, GET /api/health?token=<this> also returns a `checks`
# object (supabaseConfigured / stripeConfigured) for the post-deploy smoke
# test. Leave unset in dev; set a random string as a Vercel env var in prod.
# HEALTH_CHECK_TOKEN=

# Direct-selling master switch (default off = curated catalogue only).
# Enable only with Stripe TEST keys on Preview/local; never on Production
# until the owner signs off Stripe live mode.
NEXT_PUBLIC_STORE_ENABLED=false

# --- Public site config (all optional; leave unset until real) ------------
# Anything unset is simply hidden in the UI. Never put placeholder values here.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_LINE_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_TIKTOK_URL=
# NEXT_PUBLIC_YOUTUBE_URL=
# Set to true only after an analytics provider is registered (lib/analytics.ts).
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
